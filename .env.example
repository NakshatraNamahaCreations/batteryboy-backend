# MongoDB Atlas connection string (Atlas > Connect > Drivers).
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/batteryboy?retryWrites=true&w=majority
MONGODB_URI=

# Any long random string — used to sign login tokens.
JWT_SECRET=change-this-to-a-long-random-string

# Port the API server listens on.
PORT=4000

# Comma-separated list of allowed origins for CORS. Use * for the Expo dev client during development.
CORS_ORIGIN=*
